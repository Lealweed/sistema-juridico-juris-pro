# Source upload only; build Vite remotely. Local builds and private material stay out.
/*
!/.vercelignore
!/api/
!/src/
!/public/
!/package.json
!/package-lock.json
!/index.html
!/vite.config.ts
!/tsconfig.json
!/tsconfig.app.json
!/tsconfig.node.json
!/tailwind.config.cjs
!/tailwind.legacy-theme.json
!/postcss.config.js
!/components.json
!/eslint.config.js
!/vercel.json

# Keep these excluded even inside an allowed source/assets directory.
**/.git
**/.git/**
**/.vercel
**/.vercel/**
**/.env*
**/node_modules
**/node_modules/**
**/tmp
**/tmp/**
**/dist
**/dist/**
**/dist-ssr
**/dist-ssr/**
